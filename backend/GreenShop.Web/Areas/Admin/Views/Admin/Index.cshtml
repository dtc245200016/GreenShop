@{
    ViewData["Title"] = "Trang quản trị Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Tổng quan hệ thống</h2>
            <p class="text-muted mb-0">Chào mừng trở lại, Quản trị viên! Dưới đây là tình hình hoạt động của GreenShop.</p>
        </div>
        <div>
            <span class="badge bg-success p-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i> Hệ thống hoạt động tốt</span>
        </div>
    </div>

    <!-- Các thẻ thống kê (Widgets) -->
    <div class="row g-4 mb-4">
        <!-- Tổng sản phẩm -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-semibold mb-1 opacity-75">Tổng sản phẩm</h6>
                            <h2 class="fw-bold mb-0">124</h2>
                        </div>
                        <div class="fs-1 opacity-50">
                            <i class="fa-solid fa-seedling"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex align-items-center justify-content-between pt-0">
                    <a href="#" class="text-white text-decoration-none small">Xem chi tiết</a>
                    <i class="fa-solid fa-angle-right small"></i>
                </div>
            </div>
        </div>

        <!-- Tổng đơn hàng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-semibold mb-1 opacity-75">Đơn hàng mới</h6>
                            <h2 class="fw-bold mb-0">45</h2>
                        </div>
                        <div class="fs-1 opacity-50">
                            <i class="fa-solid fa-shopping-cart"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex align-items-center justify-content-between pt-0">
                    <a href="#" class="text-white text-decoration-none small">Xem chi tiết</a>
                    <i class="fa-solid fa-angle-right small"></i>
                </div>
            </div>
        </div>

        <!-- Doanh thu -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-semibold mb-1 opacity-75">Doanh thu tháng</h6>
                            <h2 class="fw-bold mb-0">12.8 Tr</h2>
                        </div>
                        <div class="fs-1 opacity-50">
                            <i class="fa-solid fa-dollar-sign"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex align-items-center justify-content-between pt-0">
                    <a href="#" class="text-dark text-decoration-none small fw-semibold">Xem chi tiết</a>
                    <i class="fa-solid fa-angle-right small"></i>
                </div>
            </div>
        </div>

        <!-- Khách hàng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-info text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-semibold mb-1 opacity-75">Thành viên</h6>
                            <h2 class="fw-bold mb-0">1,250</h2>
                        </div>
                        <div class="fs-1 opacity-50">
                            <i class="fa-solid fa-users"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex align-items-center justify-content-between pt-0">
                    <a href="#" class="text-white text-decoration-none small">Xem chi tiết</a>
                    <i class="fa-solid fa-angle-right small"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Phần bảng dữ liệu nhanh hoặc thông báo -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-3 bg-white">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold m-0 text-secondary"><i class="fa-solid fa-list-check me-2"></i>Lối tắt chức năng quản lý</h5>
                </div>
                <div class="card-body border-top">
                    <p class="text-muted">Chọn các chức năng bên dưới để bắt đầu quản lý dữ liệu hệ thống cây cảnh GreenShop:</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-primary"><i class="fa-solid fa-box-open me-1"></i> Quản lý Sản phẩm</button>
                        <button class="btn btn-outline-success"><i class="fa-solid fa-tags me-1"></i> Quản lý Danh mục</button>
                        <button class="btn btn-outline-dark"><i class="fa-solid fa-receipt me-1"></i> Quản lý Đơn hàng</button>
                        <button class="btn btn-outline-secondary"><i class="fa-solid fa-user-shield me-1"></i> Phân quyền & Người dùng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>