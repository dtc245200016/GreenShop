<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123D2C" />
    <title>@ViewData["Title"] · GreenShop</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <link rel="preload" href="~/fonts/be-vietnam-pro/be-vietnam-pro-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/be-vietnam-pro/be-vietnam-pro-400-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/admin-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront-theme.css" asp-append-version="true" />
    @if(ViewContext.RouteData.Values["controller"]?.ToString() is "ThanhToan" or "GioHang") { <link rel="stylesheet" href="~/css/payment-shipping.css" asp-append-version="true" /> }
</head>
<body class="storefront">
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
@await Component.InvokeAsync("StoreNavigation", new { placement = "Header" })
<main id="main-content" class="shop-container" tabindex="-1">
    <partial name="_ShopFeedback" />
    @RenderBody()
</main>
@await Component.InvokeAsync("StoreNavigation", new { placement = "Footer" })
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/storefront.js" asp-append-version="true" defer></script>
<script src="~/js/storefront-theme.js" asp-append-version="true" defer></script>
@if(ViewContext.RouteData.Values["controller"]?.ToString() is "ThanhToan" or "GioHang") { <script src="~/js/payment-shipping.js" asp-append-version="true" defer></script> }
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
