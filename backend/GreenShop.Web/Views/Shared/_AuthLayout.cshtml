<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · GreenShop</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <link rel="preload" href="~/fonts/be-vietnam-pro/be-vietnam-pro-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/be-vietnam-pro/be-vietnam-pro-400-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/admin-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront-theme.css" asp-append-version="true" />
</head>
<body class="storefront auth-page">
<header class="shop-container auth-header"><a class="shop-brand" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-leaf" aria-hidden="true"></i><span>GreenShop<small>SỐNG XANH MỖI NGÀY</small></span></a><a asp-controller="SanPham" asp-action="CuaHang">Về cửa hàng <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></header>
<main role="main" class="auth-main">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/storefront.js" asp-append-version="true" defer></script>
<script src="~/js/storefront-theme.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
