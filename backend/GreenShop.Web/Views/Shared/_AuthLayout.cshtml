<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            color: #334155;
            display: flex;
            align-items: stretch;
        }

        main[role="main"] {
            display: flex;
            flex: 1 0 auto;
            align-items: center;
            justify-content: center;
            padding: clamp(1rem, 3vh, 2.5rem) 1rem;
        }

        .auth-container {
            width: min(1140px, 100%);
            margin: auto;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, .1);
            transition: box-shadow .3s ease, transform .3s ease;
        }

        .auth-container:hover {
            box-shadow: 0 26px 60px rgba(15, 23, 42, .16);
            transform: translateY(-2px);
        }

        .auth-banner {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: clamp(2.5rem, 5vw, 4rem);
            color: #fff;
            background-position: center;
            background-size: cover;
        }

        .auth-form-wrapper {
            padding: clamp(2.5rem, 5vw, 4rem);
        }

        .auth-form-wrapper .form-control,
        .auth-form-wrapper .input-group-text,
        .auth-form-wrapper .input-group .btn {
            min-height: 48px;
            border-color: #dbe4e8;
            transition: border-color .22s ease, box-shadow .22s ease, background-color .22s ease;
        }

        .auth-form-wrapper .form-control:hover,
        .auth-form-wrapper .input-group .btn:hover {
            border-color: #86c9a6;
        }

        .auth-form-wrapper .form-control:focus {
            position: relative;
            z-index: 2;
            border-color: #198754;
            box-shadow: 0 0 0 .22rem rgba(25, 135, 84, .16);
        }

        .auth-form-wrapper .input-group:focus-within {
            border-radius: .375rem;
            box-shadow: 0 0 0 .22rem rgba(25, 135, 84, .12);
        }

        .auth-form-wrapper .input-group:focus-within .input-group-text,
        .auth-form-wrapper .input-group:focus-within .form-control,
        .auth-form-wrapper .input-group:focus-within .btn {
            border-color: #198754;
        }

        .auth-form-wrapper .input-group .form-control:focus {
            box-shadow: none;
        }

        .auth-form-wrapper button[type="submit"] {
            min-height: 50px;
            transition: transform .22s ease, box-shadow .22s ease, background-color .22s ease;
        }

        .auth-form-wrapper button[type="submit"]:hover {
            background-color: #157347;
            box-shadow: 0 10px 20px rgba(25, 135, 84, .22) !important;
            transform: translateY(-2px);
        }

        .auth-form-wrapper button[type="submit"]:active {
            transform: translateY(0);
        }

        .auth-form-wrapper a {
            transition: color .2s ease, text-decoration-color .2s ease;
        }

        .auth-form-wrapper a:hover {
            color: #146c43 !important;
            text-decoration: underline !important;
            text-underline-offset: 3px;
        }

        @@media (max-width: 767.98px) {
            .auth-container {
                width: min(560px, 100%);
                border-radius: 20px;
            }

            .auth-form-wrapper {
                padding: clamp(1.75rem, 7vw, 2.75rem);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>
<body>
    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
